{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "vite-plugin-pwa/client",
      "node"
    ],
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src",
    "scripts/*.ts",
    "tests",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
